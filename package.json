{
  "name": "photo-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "A React/Vite photo portfolio with trip management",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-metadata.js && node scripts/optimize-images.js && vite build",
    "build:metadata": "node scripts/build-metadata.js",
    "build:images": "node scripts/optimize-images.js",
    "preview": "vite preview",
    "add-trip": "node scripts/add-trip.js"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "terser": "^5.46.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "sharp": "^0.32.0",
    "vite": "^8.0.3"
  }
}
